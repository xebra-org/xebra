{
  "name": "@xebra/sdk",
  "version": "0.0.0",
  "description": "Native USDC between chains over Circle CCTP: routes, quotes, unsigned transactions and transfer status.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./build": "./dist/build/index.js",
    "./openapi": "./dist/api/openapi.js",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "openapi": "tsc -p tsconfig.build.json && node scripts/write-openapi.mjs"
  },
  "dependencies": {
    "@mysten/sui": "2.22.1",
    "@stellar/stellar-base": "^13.0.0",
    "@stellar/stellar-sdk": "^13.0.0",
    "@xebra/cctp-evm": "workspace:*",
    "viem": "^2.21.0",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@readme/openapi-parser": "10.0.0",
    "@types/node": "^22.10.0",
    "@xebra/network-config": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
